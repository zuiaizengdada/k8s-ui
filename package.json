{
  "name": "k8s-ui-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -C play dev",
    "build": "pnpm -r build",
    "test": "vitest",
    "test:components": "vitest packages/components",
    "test:hooks": "vitest packages/hooks",
    "test:utils": "vitest packages/utils",
    "gen": "esno scripts/gen.ts",
    "type-check": "pnpm -r run type-check",
    "lint": "eslint . --fix",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "element-plus": "^2.5.0",
    "happy-dom": "^20.0.11",
    "typescript": "^5.2.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.3",
    "@types/prompts": "^2.4.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.23",
    "chalk": "^5.6.2",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.2",
    "esno": "^4.8.0",
    "fs-extra": "^11.3.3",
    "globals": "^17.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prompts": "^2.4.2",
    "tailwindcss": "^4.1.18",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.2"
  }
}
